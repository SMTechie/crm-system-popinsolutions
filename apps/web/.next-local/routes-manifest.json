{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/accounting/[submodule]",
      "regex": "^/accounting/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsubmodule": "nxtPsubmodule"
      },
      "namedRegex": "^/accounting/(?<nxtPsubmodule>[^/]+?)(?:/)?$"
    },
    {
      "page": "/assets/[id]",
      "regex": "^/assets/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/assets/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/crm/[submodule]",
      "regex": "^/crm/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsubmodule": "nxtPsubmodule"
      },
      "namedRegex": "^/crm/(?<nxtPsubmodule>[^/]+?)(?:/)?$"
    },
    {
      "page": "/hr/[submodule]",
      "regex": "^/hr/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsubmodule": "nxtPsubmodule"
      },
      "namedRegex": "^/hr/(?<nxtPsubmodule>[^/]+?)(?:/)?$"
    },
    {
      "page": "/settings/[submodule]",
      "regex": "^/settings/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsubmodule": "nxtPsubmodule"
      },
      "namedRegex": "^/settings/(?<nxtPsubmodule>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
